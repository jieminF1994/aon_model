<computation-library-root name="ThreeBondPortfolio" version="master" format-version="20">
  <UserUDFs>
    <udf name="find_idx">int\sfind_idx(real\sarg,\sreal[N]\sarray)\r\n
\s\s\s\s$result\s=\s-1\r\n
\s\s\s\sfor\si\s=\s0\sto\sN\s-\s1\r\n
\s\s\s\s\s\s\s\sif\scompare(arg\s==\sarray[i],\s1e-6)\sthen\r\n
\s\s\s\s\s\s\s\s\s\s\s\s$result\s=\si\r\n
\s\s\s\s\s\s\s\s\s\s\s\sreturn\r\n
\s\s\s\s\s\s\s\send\r\n
\s\s\s\send\r\n
end</udf>
    <udf name="compute_bond_weight">real\scompute_bond_weight(\r\n
\s\s\s\sint\sidx,\s\r\n
\s\s\s\sreal[3]\sdurations_swap,\r\n
\s\s\s\sreal[3]\sdurations_credit,\s\s\s\s\s\r\n
\s\s\s\sreal[3]\sconvexities_swap,\s\r\n
\s\s\s\sreal[3]\sconvexities_credit,\s\r\n
\s\s\s\sreal\sduration_target,\s\r\n
\s\s\s\sreal\sconvexity_target,\r\n
\s\s\s\sbool\suse_credit_spread\r\n
)\r\n
\s\s\s\sreal[3]\sdurations\r\n
\s\s\s\sreal[3]\sconvexities\r\n
\s\s\s\s\r\n
\s\s\s\sfor\si\s=\s0\sto\s2\r\n
\s\s\s\s\s\s\s\sdurations[i]\s=\siif(use_credit_spread,\sdurations_credit[i],\sdurations_swap[i])\r\n
\s\s\s\s\s\s\s\sconvexities[i]\s=\siif(use_credit_spread,\sconvexities_credit[i],\sconvexities_swap[i])\r\n
\s\s\s\send\r\n
\s\s\s\s\r\n
\s\s\s\s//\sIf\sno\sconvexity\starget\sis\sgiven\s(NaN)\swe\sneed\sto\ssolve\sa\s2x2\sset\sof\sequations\shere.\s\sWe\suse\sthe\sclosed-form\sexperession\r\n
\s\s\s\s//\sfor\sthe\sinverse\sof\sa\s2x2\smatrix.\r\n
\s\s\s\s//\r\n
\s\s\s\s//\sRef:\shttps://en.wikipedia.org/wiki/Invertible_matrix#Inversion_of_2_%C3%97_2_matrices\r\n
\s\s\s\sif\sconvexity_target\s!=\sconvexity_target\sthen\s//\sChecks\sif\sconvexity_target\sis\sNaN\r\n
\s\s\s\s\s\s\s\sreal\sdet\s=\sdurations[1]\s-\sdurations[2]\r\n
\s\s\s\s\s\s\s\s\r\n
\s\s\s\s\s\s\s\sif\sidx\s==\s1\sthen\r\n
\s\s\s\s\s\s\s\s\s\s\s\s$result\s=\s\sduration_target\s-\sdurations[2]\r\n
\s\s\s\s\s\s\s\selif\sidx\s==\s2\sthen\r\n
\s\s\s\s\s\s\s\s\s\s\s\s$result\s=\s-duration_target\s+\sdurations[1]\r\n
\s\s\s\s\s\s\s\selse\r\n
\s\s\s\s\s\s\s\s\s\s\s\s$result\s=\s0\r\n
\s\s\s\s\s\s\s\send\r\n
\s\s\s\s\s\s\s\s\r\n
\s\s\s\s\s\s\s\s$result\s=\s$result\s/\sdet\r\n
\s\s\s\s\s\s\s\sreturn\r\n
\s\s\s\send\r\n
\s\s\s\s\r\n
\s\s\s\s//\sIf\sa\sconvexity\starget\sis\sgiven\swe\sneed\sto\ssolve\sa\s3x3\sset\sof\sequations\shere.\s\sWe\suse\sthe\sclosed-form\sexperession\r\n
\s\s\s\s//\sfor\sthe\sinverse\sof\sa\s3x3\smatrix.\r\n
\s\s\s\s//\r\n
\s\s\s\s//\sRef:\shttps://en.wikipedia.org/wiki/Invertible_matrix#Inversion_of_3_%C3%97_3_matrices\r\n
\s\s\s\sreal\sA\s=\sconvexities[1]\s-\sconvexities[2]\r\n
\s\s\s\sreal\sB\s=\s-(convexities[0]\s-\sconvexities[2])\r\n
\s\s\s\sreal\sC\s=\sconvexities[0]\s-\sconvexities[1]\r\n
\s\s\s\sreal\sD\s=\s-(durations[1]\s-\sdurations[2])\r\n
\s\s\s\sreal\sE\s=\sdurations[0]\s-\sdurations[2]\r\n
\s\s\s\sreal\sF\s=\s-(durations[0]\s-\sdurations[1])\r\n
\s\s\s\sreal\sG\s=\sdurations[1]\s*\sconvexities[2]\s-\sdurations[2]\s*\sconvexities[1]\r\n
\s\s\s\sreal\sH\s=\s-(durations[0]\s*\sconvexities[2]\s-\sdurations[2]\s*\sconvexities[0])\r\n
\s\s\s\sreal\sI\s=\sdurations[0]\s*\sconvexities[1]\s-\sdurations[1]\s*\sconvexities[0]\r\n
\s\s\s\sreal\sdet\s=\sA\s*\sdurations[0]\s+\sB\s*\sdurations[1]\s+\sC\s*\sdurations[2]\r\n
\s\s\s\s\r\n
\s\s\s\sif\sidx\s==\s0\sthen\r\n
\s\s\s\s\s\s\s\s$result\s=\sA\s*\sduration_target\s+\sD\s*\sconvexity_target\s+\sG\r\n
\s\s\s\selif\sidx\s==\s1\sthen\r\n
\s\s\s\s\s\s\s\s$result\s=\sB\s*\sduration_target\s+\sE\s*\sconvexity_target\s+\sH\r\n
\s\s\s\selse\r\n
\s\s\s\s\s\s\s\s$result\s=\sC\s*\sduration_target\s+\sF\s*\sconvexity_target\s+\sI\r\n
\s\s\s\send\r\n
\s\s\s\s\r\n
\s\s\s\s$result\s=\s$result\s/\sdet\r\n
end</udf>
    <udf name="compute_yield">real\scompute_yield(\r\n
\s\s\s\sreal\sweight_0,\s\r\n
\s\s\s\sreal\sweight_1,\s\r\n
\s\s\s\sreal\sweight_2,\s\r\n
\s\s\s\sreal[3]\sdfs_swap,\r\n
\s\s\s\sreal[3]\sdfs_credit,\r\n
\s\s\s\sbool\suse_credit_spread,\r\n
\s\s\s\sreal[3]\stenors,\s\r\n
\s\s\s\sreal\syield_approx\r\n
)\r\n
\s\s\s\sint\sN_ITER\s=\s10\r\n
\s\s\s\sreal\syield\s=\syield_approx\r\n
\s\s\s\sreal\sprice\r\n
\s\s\s\sreal\sgrad\r\n
\s\s\s\sreal\stmp\r\n
\s\s\s\sreal[3]\sweights\r\n
\s\s\s\sweights[0]\s=\sweight_0\r\n
\s\s\s\sweights[1]\s=\sweight_1\r\n
\s\s\s\sweights[2]\s=\sweight_2\r\n
\s\s\s\sreal[3]\sdfs\r\n
\s\s\s\sfor\si\s=\s0\sto\s2\r\n
\s\s\s\s\s\s\s\sdfs[i]\s=\siif(use_credit_spread,\sdfs_credit[i],\sdfs_swap[i])\r\n
\s\s\s\send\r\n
\s\s\s\sreal\spar\s=\ssumproduct(weights,\sdfs)\r\n
\s\s\s\s\r\n
\s\s\s\sfor\siter\s=\s0\sto\sN_ITER\s-\s1\r\n
\s\s\s\s\s\s\s\sprice\s=\s0\r\n
\s\s\s\s\s\s\s\sgrad\s=\s0\r\n
\s\s\s\s\s\s\s\sfor\si\s=\s0\sto\s2\r\n
\s\s\s\s\s\s\s\s\s\s\s\stmp\s=\s(1\s+\syield\s/\s2)\r\n
\s\s\s\s\s\s\s\s\s\s\s\sprice\s=\sprice\s+\sweights[i]\s*\s\stmp\s^\s(-2\s*\stenors[i])\r\n
\s\s\s\s\s\s\s\s\s\s\s\sgrad\s=\sgrad\s+\s-tenors[i]\s*\stmp\s^\s(-2\s*\stenors[i]\s+\s1)\r\n
\s\s\s\s\s\s\s\send\r\n
\s\s\s\s\s\s\s\s\r\n
\s\s\s\s\s\s\s\syield\s=\syield\s-\s(price\s-\spar)\s/\sgrad\r\n
\s\s\s\send\r\n
\s\s\s\s$result\s=\syield\r\n
\r\n
end</udf>
    <udf name="compute_variance">real\scompute_variance(real[N]\szcb_std,\sreal[N]\sweights)\r\n
\s\s\s\sfor\si\s=\s0\sto\sN\s-\s1\r\n
\s\s\s\s\s\s\s\s$result\s=\sweights[i]\s*\szcb_std[i]\s^\s2\r\n
\s\s\s\send\r\n
end</udf>
    <udf name="sumproduct_weights">real\ssumproduct_weights(real\sweight_0,\sreal\sweight_1,\sreal\sweight_2,\sreal[3]\sarray_swap,\sreal[3]\sarray_credit,\sbool\suse_credit_spread)\r\n
\s\s\s\sreal[3]\sweight\r\n
\s\s\s\sweight[0]\s=\sweight_0\r\n
\s\s\s\sweight[1]\s=\sweight_1\r\n
\s\s\s\sweight[2]\s=\sweight_2\r\n
\s\s\s\s\r\n
\s\s\s\s$result\s=\siif(use_credit_spread,\ssumproduct(weight,\sarray_credit),\ssumproduct(weight,\sarray_swap))\r\n
end</udf>
  </UserUDFs>
