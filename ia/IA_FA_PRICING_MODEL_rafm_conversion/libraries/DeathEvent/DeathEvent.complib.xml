      <field name="age" type="int" shape="*" />
      <field name="marriage_rate" type="real" shape="*" />
      <field name="divorce_rate" type="real" shape="*" />
    </input>
    <input name="mortality_rate_1_spouse" type="real" shape="*" />
    <input name="policy_age_1_spouse" type="int" shape="*" />
    <input name="mawa_id" type="int" />
    <input name="pip_id" type="int" />
    <input name="glb_mawa_rate" type="composite" shape="*">
