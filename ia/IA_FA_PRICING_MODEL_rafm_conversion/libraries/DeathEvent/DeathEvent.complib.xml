    </input>
    <input name="glb_pip_rate" type="composite" shape="*">
      <field name="pip_id" type="int" />
      <field name="pip_rate" type="real" shape="*" />
    </input>
    <input name="mawa_rate_idx" type="int" />
    <input name="is_flex" type="bool" />
    <input name="pip_rate_idx" type="int" />
    <input name="min_joint_age" type="int" shape="*" />
    <input name="disable_flex" type="bool" />
    <input name="flex_mawa_id" type="int" />
    <input name="flex_pip_id" type="int" />
    <input name="is_anniversary" type="bool" shape="*" />
    <input name="flex_mawa_rate_single_idx" type="int" />
    <input name="flex_pip_rate_single_idx" type="int" />
    <input name="flex_mawa_rate_joint_idx" type="int" />
    <input name="flex_pip_rate_joint_idx" type="int" />
    <input name="systematic_withdrawal_started" type="bool" modifier="Cashflow" />
    <input name="disable_confinement_rider" type="bool" />
    <input name="disable_dual_mortality" type="bool" />
    <input name="time" type="real" shape="*" description="The beginning of the time period (in year)" />
    <input name="time_dt" type="real" shape="*" description="The length of the time period (in year)" />
    <input name="proj_date" type="date_t" shape="*" description="The date of the beginning of the time period" />
    <input name="conf_event_randu" type="real" shape="*" modifier="Cashflow" />
    <input name="recovery_event_randu" type="real" shape="*" modifier="Cashflow" />
    <input name="AIG_mort_1" type="real" shape="*" />
    <input name="AIG_mort_2" type="real" shape="*" />
    <input name="issue_age_1" type="int" />
    <input name="issue_age_2" type="int" />
    <input name="confinement_rate_annual_1" type="composite">
      <field name="incidence_rate" type="real" shape="*,*" />
      <field name="recovery_rate" type="real" shape="*,*" />
      <field name="c_mortality_rate" type="real" shape="*,*" />
      <field name="nc_mortality_rate" type="real" shape="*,*" />
      <field name="benefit_utilization_rate" type="real" />
    </input>
    <input name="conf_benefit_util_randu" type="real" modifier="Cashflow" />
    <input name="confinement_rate_annual_2" type="composite">
      <field name="incidence_rate" type="real" shape="*,*" />
      <field name="recovery_rate" type="real" shape="*,*" />
      <field name="c_mortality_rate" type="real" shape="*,*" />
      <field name="nc_mortality_rate" type="real" shape="*,*" />
      <field name="benefit_utilization_rate" type="real" />
    </input>
    <input name="confinement_rate_annual_1_spouse" type="composite">
      <field name="incidence_rate" type="real" shape="*,*" />
      <field name="recovery_rate" type="real" shape="*,*" />
      <field name="c_mortality_rate" type="real" shape="*,*" />
      <field name="nc_mortality_rate" type="real" shape="*,*" />
      <field name="benefit_utilization_rate" type="real" />
    </input>
    <input name="is_confinement_eligible" type="bool" />
    <input name="issue_age_1_spouse" type="int" />
    <input name="is_confined" type="bool" />
    <input name="apply_lad" type="bool" />
    <input name="is_after_maturity_date" type="bool" modifier="Cashflow" />
    <input name="living_benefit_elected" type="bool" />
    <input name="lad_mawa_amount" type="real" modifier="Cashflow" />
    <input name="lad_pip_amount" type="real" modifier="Cashflow" />
  </inputs>
  <results>
    <result name="launch_db_this_period" ref="=Projection.launch_db_this_period" />
    <result name="policy_inforce_ind_eop" ref="=Projection.policy_inforce_ind_eop" />
    <result name="mawp_flex_last_anniversary" ref="=Projection.mawp_flex_last_anniversary" />
    <result name="pipp_flex_last_anniversary" ref="=Projection.pipp_flex_last_anniversary" />
    <result name="mawp_flex" ref="=Projection.mawp_flex" />
    <result name="pipp_flex" ref="=Projection.pipp_flex" />
    <result name="confined_this_period" ref="=Projection.confined_this_period" />
    <result name="confinement_benefit_util_bool" ref="=Projection.confinement_benefit_util_bool" />
  </results>
  <calculations>
    <table name="Projection" type="CashFlow">
      <columns>
        <c name="step" datatype="int" />
        <c name="confine_prob_1" datatype="real" />
        <c name="confine_prob_2" datatype="real" />
        <c name="confine_prob_1_spouse" datatype="real" />
        <c name="is_person_1_confined" datatype="bool" />
        <c name="is_person_2_confined" datatype="bool" />
        <c name="confine_age_1" datatype="int" />
        <c name="confine_age_2" datatype="int" />
        <c name="confine_age_1_spouse" datatype="int" />
        <c name="confine_time_1" datatype="real" />
        <c name="confine_time_2" datatype="real" />
        <c name="confine_time_1_spouse" datatype="real" />
        <c name="dual_mortality_rate_1" datatype="real" />
        <c name="dual_mortality_rate_2" datatype="real" />
        <c name="dual_mortality_rate_1_spouse" datatype="real" />
        <c name="recover_prob_1" datatype="real" />
        <c name="recover_prob_2" datatype="real" />
        <c name="recover_prob_1_spouse" datatype="real" />
        <c name="is_person_1_recovered" datatype="bool" />
        <c name="is_person_2_recovered" datatype="bool" />
        <c name="confined_this_period" datatype="bool" />
        <c name="death_prob_1" datatype="real" />
        <c name="death_prob_2" datatype="real" />
        <c name="person_1_death_this_period" datatype="bool" />
        <c name="is_person_1_alive" datatype="bool" />
        <c name="person_2_death_this_period" datatype="bool" />
        <c name="is_person_2_alive" datatype="bool" />
        <c name="lad_mawa" datatype="real" />
        <c name="lad_pip" datatype="real" />
        <c name="launch_db_this_period" datatype="bool" />
        <c name="policy_inforce_ind_eop" datatype="int" />
        <c name="single_joint_bop" datatype="int" />
        <c name="marriage_rate" datatype="real" />
        <c name="randu" datatype="real" />
        <c name="divorce_rate" datatype="real" />
        <c name="flex_start_time" datatype="bool" />
        <c name="single_joint_eop" datatype="int" />
        <c name="has_single_flexed_to_joint" datatype="bool" />
        <c name="mawp_flex" datatype="real" />
        <c name="pipp_flex" datatype="real" />
        <c name="mawp_flex_last_anniversary" datatype="real" />
        <c name="pipp_flex_last_anniversary" datatype="real" />
        <c name="confinement_benefit_util_bool" datatype="bool" />
      </columns>
      <data>
        <row-group name="rg1">
          <repeat>=1</repeat>
          <columns>
            <c name="step">/*\s\r\n
The\sindex\sof\sprojection\speriod\r\n
*/\r\n
\r\n
=0</c>
            <c name="confine_prob_1">annual_rate\s=\sconfinement_rate_annual_1.incidence_rate[max(min(issue_age_1-50,65),0),\smin(policy_age_1[step]\s-\sissue_age_1,59)]\r\n
\r\n
return\s1-(1-annual_rate)^time_dt[step]</c>
            <c name="confine_prob_2">annual_rate\s=\sconfinement_rate_annual_2.incidence_rate[max(min(issue_age_2-50,65),0),\smin(policy_age_2[step]\s-\sissue_age_2,59)]\r\n
\r\n
return\s1-(1-annual_rate)^time_dt[step]</c>
            <c name="confine_prob_1_spouse">annual_rate\s=\sconfinement_rate_annual_1_spouse.incidence_rate[max(min(issue_age_1_spouse-50,65),0),\smin(policy_age_1[step]\s-\sissue_age_1,59)]\r\n
\r\n
return\s1-(1-annual_rate)^time_dt[step]</c>
            <c name="is_person_1_confined">//\swhen\sdatabase\shas\sboth\sperson's\sconfined\sstatus,\swill\supdate\sthis\sformula\r\n
=\sis_confined</c>
            <c name="is_person_2_confined">//\swhen\sdatabase\shas\sboth\sperson's\sconfined\sstatus,\swill\supdate\sthis\sformula\r\n
=\sFalse</c>
            <c name="confine_age_1">=\spolicy_age_1[step]</c>
            <c name="confine_age_2">=\spolicy_age_2[step]</c>
            <c name="confine_age_1_spouse">=\spolicy_age_1_spouse[step]</c>
            <c name="confine_time_1">//\swhen\sdatabase\shas\sthe\sconfined\sdate\sdata,\swill\supdate\sthis\sformula\r\n
=\stime[step]</c>
            <c name="confine_time_2">//\swhen\sdatabase\shas\sthe\sconfined\sdate\sdata,\swill\supdate\sthis\sformula\r\n
=\stime[step]</c>
            <c name="confine_time_1_spouse">//\swhen\sdatabase\shas\sthe\sconfined\sdate\sdata,\swill\supdate\sthis\sformula\r\n
=\stime[step]</c>
            <c name="dual_mortality_rate_1">0</c>
            <c name="dual_mortality_rate_2">0</c>
            <c name="dual_mortality_rate_1_spouse">0</c>
            <c name="recover_prob_1">elapsed_year\s=\sfloor(time[step]\s-\sconfine_time_1)\s\s/*change\st\sin\syear\sto\smonthly\s*/\r\n
\r\n
annual_rate\s=\sconfinement_rate_annual_1.recovery_rate[max(min(confine_age_1-50,65),0),\smin(elapsed_year,59)]\r\n
\r\n
return\s1-(1-annual_rate)^time_dt[step]</c>
            <c name="recover_prob_2">elapsed_year\s=\sfloor(time[step]\s-\sconfine_time_2)\s\s/*change\st\sin\syear\sto\smonthly\s*/\r\n
\r\n
annual_rate\s=\sconfinement_rate_annual_2.recovery_rate[max(min(confine_age_2-50,65),0),\smin(elapsed_year,59)]\r\n
\r\n
return\s1-(1-annual_rate)^time_dt[step]</c>
            <c name="recover_prob_1_spouse">elapsed_year\s=\sfloor(time[step]\s-\sconfine_time_1)\s\s/*change\st\sin\syear\sto\smonthly\s*/\r\n
\r\n
annual_rate\s=\sconfinement_rate_annual_1_spouse.recovery_rate[max(min(confine_age_1_spouse-50,65),0),\smin(elapsed_year,59)]\r\n
\r\n
return\s1-(1-annual_rate)^time_dt[step]</c>
            <c name="is_person_1_recovered">=\sFalse\r\n
\s\s\s\s</c>
            <c name="is_person_2_recovered">=\sFalse</c>
            <c name="confined_this_period">if\sis_person_1_confined\sor\sis_person_2_confined\sthen\r\n
\s\s\s\sreturn\sTrue\r\n
else\s\r\n
\s\s\s\sreturn\sFalse\r\n
end</c>
            <c name="death_prob_1">if\s!disable_confinement_rider\sand\s!disable_dual_mortality\sand\sis_confinement_eligible\sthen\r\n
\s\s\s\sreturn\sdual_mortality_rate_1\r\n
else\s\r\n
\s\s\s\sreturn\smortality_rate_1[step]\r\n
end</c>
            <c name="death_prob_2">if\s!disable_confinement_rider\sand\s!disable_dual_mortality\sand\sis_confinement_eligible\sthen\r\n
\s\s\s\sreturn\sdual_mortality_rate_2\r\n
else\s\r\n
\s\s\s\sreturn\smortality_rate_2[step]\r\n
end</c>
            <c name="person_1_death_this_period">=\sFalse</c>
            <c name="is_person_1_alive">=\sTrue</c>
            <c name="person_2_death_this_period">=\sFalse</c>
            <c name="is_person_2_alive">=\sis_joint_policy</c>
            <c name="lad_mawa">=\slad_mawa_amount</c>
            <c name="lad_pip">=\slad_pip_amount</c>
            <c name="launch_db_this_period">=\sFalse</c>
            <c name="policy_inforce_ind_eop">=\spolicy_inforce_ind_bop</c>
            <c name="single_joint_bop">/*\r\n
0\sfor\sboth\sdied\sor\ssingle\sperson\sdied\r\n
1\sfor\sperson_1\scovered\r\n
2\sfor\sperson_2\scovered\r\n
3\sfor\sjoint\r\n
*/\r\n
if\s!is_person_1_alive\sand\s!is_person_2_alive\sthen\s\r\n
\s\s\s\sreturn\s0\r\n
elif\sis_person_1_alive\sand\s!is_person_2_alive\sthen\r\n
\s\s\s\sreturn\s1\r\n
elif\s!is_person_1_alive\sand\sis_person_2_alive\sthen\r\n
\s\s\s\sreturn\s2\r\n
else\r\n
\s\s\s\sreturn\s3\r\n
end\r\n
</c>
            <c name="marriage_rate">/*\r\n
single_joint_bop:\r\n
0\sfor\sboth\sdied\r\n
1\sfor\sperson_1\ssingle\r\n
2\sfor\sperson_2\ssingle\r\n
3\sfor\sjoint\r\n
*/\r\n
if\ssingle_joint_bop\s=\s0\sthen\s\r\n
\s\s\s\sreturn\s0\r\n
elif\ssingle_joint_bop\s=\s1\sthen\s\r\n
\s\s\s\sreturn\smarriage_divorce_rate(policy_age_1[step],\smarriage_divorce_rates.age,\smarriage_divorce_rates.marriage_rate)\r\n
elif\ssingle_joint_bop\s=\s2\sthen\s\r\n
\s\s\s\sreturn\smarriage_divorce_rate(policy_age_2[step],\smarriage_divorce_rates.age,\smarriage_divorce_rates.marriage_rate)\r\n
else\r\n
\s\s\s\sreturn\s0\r\n
end</c>
            <c name="randu">=marriage_divorce_randu</c>
            <c name="divorce_rate">/*\r\n
single_joint_bop:\r\n
0\sfor\sboth\sdied\r\n
1\sfor\sperson_1\ssingle\r\n
2\sfor\sperson_2\ssingle\r\n
3\sfor\sjoint\r\n
*/\r\n
if\ssingle_joint_bop\s=\s3\sthen\s\r\n
\s\s\s\sreturn\smarriage_divorce_rate(max(policy_age_1[step],\spolicy_age_2[step]),\smarriage_divorce_rates.age,\smarriage_divorce_rates.divorce_rate)\r\n
else\s\r\n
\s\s\s\sreturn\s0\r\n
end</c>
            <c name="flex_start_time">=\sFalse\r\n
\r\n
</c>
            <c name="single_joint_eop">/*\r\n
single_joint_eop:\r\n
0\sfor\sboth\sdied\sor\ssingle\sperson\sdied\r\n
1\sfor\sperson_1\scovered\r\n
2\sfor\sperson_2\scovered\r\n
3\sfor\sjoint\r\n
*/\r\n
if\sis_flex\sand\s!disable_flex\sand\sflex_start_time\sthen\s\r\n
\s\s\s\s//joint\spolicy,\sone\sperson\sdied,\sthe\sother\swill\slose\sflex\sfeature\sand\sstay\ssingle\scovered\r\n
\s\s\s\s//single\spolicy,\sif\sget\smarried,\schoose\sjoint\scoverage\r\n
\s\s\s\sif\ssingle_joint_bop\s=\s1\sor\ssingle_joint_bop\s=\s2\sthen\r\n
\s\s\s\s\s\s\s\sreturn\siif(is_joint_policy,\ssingle_joint_bop,\s\r\n
\s\s\s\s\s\s\s\s\s\s\s\siif(compare(marriage_divorce_randu\s&lt;=\smarriage_rate,\s1e-10),\s3,\ssingle_joint_bop))\r\n
\s\s\s\selif\ssingle_joint_bop\s=\s3\sthen\r\n
\s\s\s\s\s//joint\spolicy,\sboth\salive,\sif\sdivorced,\s50/50\ssingle\scoverage\r\n
\s\s\s\s\s\s\sif\scompare(marriage_divorce_randu\s&lt;=\sdivorce_rate\s/\s2,\s1e-10)\sthen\r\n
\s\s\s\s\s\s\s\s\s\sreturn\s1\r\n
\s\s\s\s\s\s\selif\scompare(marriage_divorce_randu\s&lt;=\sdivorce_rate,\s1e-10)\sthen\s\r\n
\s\s\s\s\s\s\s\s\s\sreturn\s2\r\n
\s\s\s\s\s\s\selse\r\n
\s\s\s\s\s\s\s\s\s\sreturn\s3\r\n
\s\s\s\s\s\s\send\r\n
\s\s\s\selse\r\n
\s\s\s\s\s\s\s\sreturn\ssingle_joint_bop\r\n
\s\s\s\send\r\n
else\r\n
\s\s\s\sreturn\ssingle_joint_bop\r\n
end\r\n
</c>
            <c name="has_single_flexed_to_joint">=\sFalse</c>
            <c name="mawp_flex">/*\r\n
Maximum\sannual\swithdrawal\spercentage\r\n
*/\r\n
if\s!is_flex\sor\sdisable_flex\sthen\r\n
\s\s\s\sreturn\s0\r\n
end\r\n
\r\n
if\ssingle_joint_eop\s=\s3\sthen\r\n
\s\s\s\sreturn\sglb_mawa_rate[flex_mawa_rate_joint_idx].mawa_rate[min(120,min_joint_age[step])]\r\n
elif\ssingle_joint_eop\s=\s1\sor\ssingle_joint_eop\s=\s2\sthen\r\n
\s\s\s\sreturn\sglb_mawa_rate[flex_mawa_rate_single_idx].mawa_rate[min(120,min_joint_age[step])]\r\n
else\r\n
\s\s\s\sreturn\s0\r\n
end\r\n
\r\n
</c>
            <c name="pipp_flex">/*\r\n
Protected\sincome\spayment\spercentage\r\n
*/\r\n
if\s!is_flex\sor\sdisable_flex\sthen\r\n
\s\s\s\sreturn\s0\r\n
end\r\n
\r\n
if\ssingle_joint_eop\s=\s3\sthen\r\n
\s\s\s\sreturn\sglb_pip_rate[flex_pip_rate_joint_idx].pip_rate[min(120,min_joint_age[step])]\r\n
elif\ssingle_joint_eop\s=\s1\sor\ssingle_joint_eop\s=\s2\sthen\r\n
\s\s\s\sreturn\sglb_pip_rate[flex_pip_rate_single_idx].pip_rate[min(120,min_joint_age[step])]\r\n
else\r\n
\s\s\s\sreturn\s0\r\n
end\r\n
\r\n
</c>
            <c name="mawp_flex_last_anniversary">=\smawp_flex</c>
            <c name="pipp_flex_last_anniversary">=\spipp_flex</c>
            <c name="confinement_benefit_util_bool">=\siif(compare(conf_benefit_util_randu\s&lt;=\sconfinement_rate_annual_1.benefit_utilization_rate,\r\n
\s\s\s\s\s\s\s\s1e-10),\sTrue,\sFalse)</c>
          </columns>
        </row-group>
        <row-group name="rg2">
          <repeat>=1</repeat>
          <columns>
            <c name="step">/*\s\r\n
The\sindex\sof\sprojection\speriod\r\n
*/\r\n
\r\n
=prev(step)+1</c>
            <c name="confine_prob_1">annual_rate\s=\sconfinement_rate_annual_1.incidence_rate[max(min(issue_age_1-50,65),0),\smin(policy_age_1[step]\s-\sissue_age_1,59)]\r\n
\r\n
return\s1-(1-annual_rate)^time_dt[step]</c>
            <c name="confine_prob_2">annual_rate\s=\sconfinement_rate_annual_2.incidence_rate[max(min(issue_age_2-50,65),0),\smin(policy_age_2[step]\s-\sissue_age_2,59)]\r\n
