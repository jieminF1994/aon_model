<?xml version="1.0" encoding="utf-8"?>
<computation-library-root name="DeathEvent" version="master" format-version="20">
  <UserUDFs>
    <udf name="marriage_divorce_rate">real\smarriage_divorce_rate(\r\n
\s\s\s\sint\sattained_age,\r\n
\s\s\s\sint[N]\sage,\r\n
\s\s\s\sreal[N]\srates)\r\n
\s\s\s\s\r\n
\s\s\s\sif\sattained_age\s&lt;\sage[0]\sthen\r\n
\s\s\s\s\s\s\s\s$result\s=\srates[0]\r\n
\s\s\s\selif\sattained_age\s&gt;\sage[N-1]\sthen\r\n
\s\s\s\s\s\s\s\s$result\s=\srates[N-1]\r\n
\s\s\s\send\r\n
\s\s\s\s\r\n
\s\s\s\sfor\si\s=\s0\sto\sN\s-\s1\r\n
\s\s\s\s\s\s\s\sif\sattained_age\s=\sage[i]\sthen\r\n
\s\s\s\s\s\s\s\s\s\s\s\s$result\s=\srates[i]\r\n
\s\s\s\s\s\s\s\s\s\s\s\sreturn\r\n
\s\s\s\s\s\s\s\send\r\n
\s\s\s\send\s\r\n
end</udf>
  </UserUDFs>
  <inputs>
    <input name="mortality_rate_1" type="real" shape="*" />
    <input name="mortality_rate_2" type="real" shape="*" />
    <input name="policy_inforce_ind_bop" type="int" modifier="Cashflow" />
    <input name="death_event_randu" type="real" shape="*" modifier="Cashflow" />
    <input name="disable_mortality" type="bool" />
    <input name="is_joint_policy" type="bool" />
    <input name="marriage_divorce_randu" type="real" modifier="Cashflow" />
    <input name="systematic_wd_start_time" type="bool" modifier="Cashflow" />
