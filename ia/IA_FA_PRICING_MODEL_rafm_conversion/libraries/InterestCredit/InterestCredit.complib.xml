<?xml version="1.0" encoding="utf-8"?>
<computation-library-root name="InterestCredit" version="master" format-version="20">
  <UserUDFs>
    <udf name="safe_return">real\ssafe_return(real\snum,\sreal\sdem)\r\n
\s\s\s\s$result\s=\siif(compare(abs(dem)\s&gt;\s0,\s1e-3),\snum\s/\sdem\s-\s1,\s0)\r\n
end</udf>
  </UserUDFs>
  <inputs>
    <input name="inforce" type="composite">
      <field name="account_value" type="real" />
      <field name="index_at_last_renewal" type="real" />
      <field name="index_floor" type="real" />
      <field name="index_at_last_fix" type="real" />
      <field name="accum_index_credit" type="real" />
      <field name="interest_bonus_rate" type="real" />
      <field name="index_cap" type="real" />
      <field name="participation_rate" type="real" />
      <field name="accum_index_term_return" type="real" />
      <field name="index_term_spread" type="real" />
      <field name="investment_account" type="int" />
      <field name="index_spread" type="real" />
      <field name="minimum_index_change_value" type="real" />
      <field name="is_mav_product" type="bool" />
      <field name="minimum_growth_rate" type="real" />
    </input>
    <input name="account_value_bop" type="real" modifier="Cashflow" />
    <input name="equity_index" type="real" modifier="Cashflow" />
    <input name="declared_parameter" type="real" shape="*" />
    <input name="time_dt" type="real" shape="*" />
    <input name="is_monthiversary" type="bool" shape="*" />
    <input name="months_since_issue" type="int" shape="*" />
    <input name="crediting_interest_now" type="bool" shape="*" />
    <input name="first_credit_now" type="bool" modifier="Cashflow" />
    <input name="pro_rata_factor" type="real" shape="*" />
    <input name="is_2yr_anniversary" type="bool" shape="*" />
    <input name="policy_year" type="int" shape="*" />
    <input name="is_end_of_index_term" type="bool" shape="*" />
    <input name="years_since_issue" type="int" shape="*" />
    <input name="years_passed_in_index_term" type="real" shape="*" />
    <input name="systematic_withdrawal_started" type="bool" modifier="Cashflow" />
    <input name="lockin_during_st" type="bool" />
    <input name="elapsed_strategy_term" type="real" modifier="Cashflow" />
    <input name="disable_withdrawal" type="bool" />
    <input name="is_annexus_10yr" type="bool" />
    <input name="is_annexus_5yr" type="bool" />
    <input name="is_annexus_accelerator" type="bool" />
    <input name="first_credit_term_passed" type="bool" shape="*" />
    <input name="accumulation_factor" type="real" modifier="Cashflow" />
    <input name="is_running_dac" type="bool" />
    <input name="crediting_term" type="int" />
    <input name="crediting_term_post_ratesetting" type="int" />
    <input name="option_value_dac" type="real" />
    <input name="option_budget_dac" type="real" />
    <input name="rider_fee" type="real" />
    <input name="years_passed_in_strategy_term" type="real" modifier="Cashflow" />
    <input name="index_strike" type="real" />
    <input name="no_rate_setting" type="bool" />
    <input name="disable_rate_setting" type="bool" />
    <input name="surrender_charge_period" type="int" />
    <input name="first_credit_passed" type="bool" modifier="Cashflow" />
    <input name="step_esg" type="int" modifier="Cashflow" />
  </inputs>
  <results>
    <result name="account_value_eop" ref="=Projection.account_value_eop" />
    <result name="interest_credit_amount" ref="=Projection.interest_credit_amount" />
    <result name="interest_credit_percentage" ref="=Projection.interest_credit_percent" />
    <result name="interest_credit_amount_pro_rata" ref="=Projection.partial_interest_credit_amount" />
    <result name="strategy_return" ref="=Projection.strategy_return" />
    <result name="lock_in_return" ref="=Projection.Lock_in_return" />
    <result name="adjusted_strategy_return" ref="=Projection.adjusted_strategy_return" />
    <result name="adjustment_factor_on_activation" ref="=Projection.adjustment_factor_on_activation" />
    <result name="x5_rider_return" ref="=Projection.x5_rider_return" />
    <result name="adjusted_x5_rider_return" ref="=Projection.adjusted_x5_rider_return" />
    <result name="p2p_return" ref="=Projection.p2p_return" />
    <result name="index_at_last_credit" ref="=Projection.index_at_last_credit" />
    <result name="interest_credit_amount_mgr" ref="=Projection.interest_credit_amount_mgr" />
    <result name="interest_credit_percent_for_liability" ref="=Projection.interest_credit_percent_for_liability" />
    <result name="interest_credit_percent_on_strategy_return_mgr" ref="=Projection.interest_credit_percent_on_strategy_return_mgr" />
  </results>
  <calculations>
    <table name="Projection" type="CashFlow">
      <columns>
        <c name="step" datatype="int" />
        <c name="credit_interest_now" datatype="bool" />
        <c name="index_at_last_credit" datatype="real" />
        <c name="p2p_return" datatype="real" />
        <c name="index_at_last_monthiversary" datatype="real" />
        <c name="index_at_last_index_term_end" datatype="real" />
        <c name="local_floor" datatype="real" />
        <c name="annexus_spread" datatype="real" />
        <c name="index_term_return" datatype="real" />
        <c name="strike" datatype="real" />
        <c name="index_term_return_accum" datatype="real" />
        <c name="Lock_in_return" datatype="bool" />
        <c name="adjustment_factor_on_activation" datatype="real" />
        <c name="adjustment_factor_daily" datatype="real" />
        <c name="annexus_strategy_return" datatype="real" />
        <c name="monthly_p2p_return" datatype="real" />
        <c name="monthly_p2p_return_accum" datatype="real" />
        <c name="monthly_sum" datatype="real" />
        <c name="n_month" datatype="int" />
        <c name="monthly_average" datatype="real" />
        <c name="monthly_average_return" datatype="real" />
        <c name="strategy_return" datatype="real" />
        <c name="x5_rider_return" datatype="real" />
        <c name="adjusted_strategy_return" datatype="real" />
        <c name="adjusted_x5_rider_return" datatype="real" />
        <c name="interest_credit_percent" datatype="real" />
        <c name="interest_credit_percent_for_liability" datatype="real" />
        <c name="interest_credit_amount" datatype="real" />
        <c name="interest_credit_percent_on_strategy_return_mgr" datatype="real" />
        <c name="interest_credit_amount_mgr" datatype="real" />
        <c name="interest_credit_amount_mgr_cdsc" datatype="real" />
        <c name="partial_interest_credit_amount" datatype="real" />
        <c name="account_value_eop" datatype="real" />
      </columns>
      <data>
        <row-group name="rg1">
          <repeat>=1</repeat>
          <columns>
            <c name="step">0</c>
            <c name="credit_interest_now">=\screditing_interest_now[step]</c>
            <c name="index_at_last_credit">=inforce.index_at_last_renewal</c>
            <c name="p2p_return">0</c>
            <c name="index_at_last_monthiversary">=inforce.index_at_last_fix</c>
            <c name="index_at_last_index_term_end">=\sinforce.index_at_last_fix</c>
            <c name="local_floor">//For\sAnnexus\sIA\r\n
\r\n
if\sis_annexus_10yr\sthen\r\n
\s\s\s\sreturn\siif(years_since_issue[step]\s&lt;\s10\sor\sdisable_rate_setting\sor\sno_rate_setting,\sInforce.index_floor,\s0)\r\n
elif\sis_annexus_5yr\sthen\r\n
\s\s\s\sreturn\siif(years_since_issue[step]\s&lt;\s15\sor\sdisable_rate_setting\sor\sno_rate_setting,\sInforce.index_floor,\s0)\r\n
else\r\n
\s\s\s\sreturn\s0\r\n
end</c>
            <c name="annexus_spread">0</c>
            <c name="index_term_return">0</c>
            <c name="strike">if\sis_annexus_10yr\s&amp;&amp;\s(first_credit_now\sor\sdisable_rate_setting\sor\sno_rate_setting)\sthen\r\n
\s\s\s\sreturn\sindex_strike\r\n
elif\sis_annexus_5yr\s&amp;&amp;\s((credit_interest_now\s&amp;&amp;\spolicy_year[step]\s&lt;\s16)\sor\sdisable_rate_setting\sor\sno_rate_setting)\sthen\r\n
\s\s\s\sreturn\sindex_strike\r\n
else\r\n
\s\s\s\sreturn\s1.0\r\n
endif</c>
            <c name="index_term_return_accum">=\sInforce.accum_index_term_return</c>
            <c name="Lock_in_return">=\sFalse</c>
            <c name="adjustment_factor_on_activation">=0</c>
            <c name="adjustment_factor_daily">=\s1\s</c>
            <c name="annexus_strategy_return">=\s0</c>
            <c name="monthly_p2p_return">0</c>
            <c name="monthly_p2p_return_accum">=\sinforce.accum_index_credit</c>
            <c name="monthly_sum">=\sinforce.accum_index_credit</c>
            <c name="n_month">=\smonths_since_issue[step]\s%\s12</c>
            <c name="monthly_average">=\siif(n_month\s!=\s0,\smonthly_sum\s/\sn_month,\s0)</c>
            <c name="monthly_average_return">=\siif(\r\n
\s\s\s\sn_month\s!=\s0,\r\n
\s\s\s\ssafe_return(monthly_average,\sindex_at_last_credit),\r\n
\s\s\s\s0\r\n
)</c>
            <c name="strategy_return">0</c>
            <c name="x5_rider_return">0</c>
            <c name="adjusted_strategy_return">=\sstrategy_return</c>
            <c name="adjusted_x5_rider_return">=\sx5_rider_return</c>
            <c name="interest_credit_percent">0</c>
            <c name="interest_credit_percent_for_liability">0</c>
            <c name="interest_credit_amount">=\s0</c>
            <c name="interest_credit_percent_on_strategy_return_mgr">0</c>
            <c name="interest_credit_amount_mgr">=\s0</c>
            <c name="interest_credit_amount_mgr_cdsc">/*\r\n
Total\sinterest\scredited\safter\sconsidering\ssurrender\scharge\speriod\r\n
*/\r\n
\r\n
=\siif(policy_year[step]\s&lt;\ssurrender_charge_period\s+\s2,\sinterest_credit_amount,\sinterest_credit_amount_mgr)</c>
            <c name="partial_interest_credit_amount">=\saccount_value_bop\s*\sstrategy_return\s*\spro_rata_factor[step]</c>
            <c name="account_value_eop">/*\r\n
account\svalue\safter\screditing\sinterest\r\n
*/\r\n
\r\n
=\smax(account_value_bop\s+\sinterest_credit_amount_mgr_cdsc,\s0)</c>
          </columns>
        </row-group>
        <row-group name="rg2">
          <repeat>=1</repeat>
          <columns>
            <c name="step">=\sprev(step)\s+\s1</c>
            <c name="credit_interest_now">=\screditing_interest_now[step]</c>
            <c name="index_at_last_credit">=\siif(prev(credit_interest_now),\sprev(equity_index),\sprev(index_at_last_credit))</c>
            <c name="p2p_return">=\ssafe_return(equity_index,\sindex_at_last_credit)</c>
            <c name="index_at_last_monthiversary">=\siif(is_monthiversary[step\s-\s1],\sprev(equity_index),\sprev(index_at_last_monthiversary))</c>
            <c name="index_at_last_index_term_end">=\siif(is_end_of_index_term[step\s-\s1],\sprev(equity_index),\sprev(index_at_last_index_term_end))</c>
            <c name="local_floor">//For\sAnnexus\sIA\r\n
\r\n
if\sis_annexus_10yr\sthen\r\n
\s\s\s\sreturn\siif(policy_year[step-1]\s&lt;\s11\sor\sdisable_rate_setting\sor\sno_rate_setting,\sInforce.index_floor,\s0)\r\n
elif\sis_annexus_5yr\sthen\r\n
\s\s\s\sreturn\siif(policy_year[step-1]\s&lt;\s16\sor\sdisable_rate_setting\sor\sno_rate_setting,\sInforce.index_floor,\s0)\r\n
else\r\n
\s\s\s\sreturn\s0\r\n
end</c>
            <c name="annexus_spread">//The\sactual\sspread\sapplied\sto\sthe\sreturn\s=\sannualized\sspread*years\spassed\sin\sindex\sterm\r\n
//At\sthe\send\sof\sthe\sindex\sterm,\swe\sshould\suse\sthe\sinteger\syear\sas\sthe\smultiplier\r\n
\r\n
=iif(first_credit_term_passed[step]\sand\s!disable_rate_setting\sand\s!no_rate_setting,\r\n
\s\s\s\s\s0,\r\n
\s\s\s\s\sInforce.index_term_spread)\r\n
\s\s\s\s\s*iif(is_end_of_index_term[step],iif(is_annexus_10yr,2,1),years_passed_in_index_term[step])</c>
            <c name="index_term_return">//index\sterm\sperformance\r\n
\r\n
=\siif(is_end_of_index_term[step],\r\n
\s\s\s\s\s\smax(safe_return(equity_index,index_at_last_index_term_end)\r\n
\s\s\s\s\s\s*\sdeclared_parameter[step_esg-1]\s-\sannexus_spread,\r\n
\s\s\s\s\s\slocal_floor),\s0)</c>
            <c name="strike">if\sis_annexus_10yr\s&amp;&amp;\s(first_credit_now\sor\sdisable_rate_setting\sor\sno_rate_setting)\sthen\r\n
\s\s\s\sreturn\sindex_strike\r\n
elif\sis_annexus_5yr\s&amp;&amp;\s((credit_interest_now\s&amp;&amp;\spolicy_year[step]\s&lt;\s16)\sor\sdisable_rate_setting\sor\sno_rate_setting)\sthen\r\n
\s\s\s\sreturn\sindex_strike\r\n
else\r\n
\s\s\s\sreturn\s1.0\r\n
endif</c>
            <c name="index_term_return_accum">//For\seach\sstrategy\sterm,\sthe\scumulated\sindex\sterm\sreturn\sis\stracked\r\n
\r\n
=\siif(prev(credit_interest_now),\sindex_term_return,\r\n
\s\s\s\s(1\s+\sprev(index_term_return_accum))\s*\s(1\s+\sindex_term_return)\s-\sstrike)\r\n
</c>
            <c name="Lock_in_return">if\sis_annexus_5yr\sand\ssystematic_withdrawal_started\sand\spolicy_year[step\s-\s1]\s&lt;\s16\r\n
\s\s\s\sand\slockin_during_st\sand\s!disable_withdrawal\sthen\s\r\n
\s\s\s\sreturn\sTrue\r\n
else\r\n
\s\s\s\sreturn\sFalse\r\n
end</c>
            <c name="adjustment_factor_on_activation">if\sis_annexus_5yr\sand\ssystematic_withdrawal_started\sand\s!prev(systematic_withdrawal_started)\r\n
\s\s\s\sand\spolicy_year[step\s-\s1]\s&lt;\s16\sand\spolicy_year[step-1]\s&gt;=11\sand\s!lockin_during_st\sthen\s\r\n
\s\s\s\sreturn\selapsed_strategy_term\r\n
else\r\n
\s\s\s\sreturn\s0\r\n
end</c>
            <c name="adjustment_factor_daily">if\sis_annexus_5yr\sand\spolicy_year[step\s-\s1]\s&lt;\s16\sand\s!lockin_during_st\sthen\s\r\n
\s\s\sif\ssystematic_withdrawal_started\sand\s!prev(systematic_withdrawal_started)\sthen\r\n
\s\s\s\s\s\s\s\sreturn\s1-\sadjustment_factor_on_activation\r\n
\s\s\s\selse\s\r\n
\s\s\s\s\s\s\s\sreturn\sprev(adjustment_factor_daily)\r\n
\s\s\s\send\r\n
else\r\n
\s\s\s\sreturn\s1\r\n
\s\s\s\s\r\n
end</c>
            <c name="annexus_strategy_return">if\sLock_in_return\sand\sprev(Lock_in_return)\sthen\r\n
\s\s\s\sreturn\sprev(strategy_return)\r\n
else\r\n
\s\s\s\sreturn\smax(0,iif(is_end_of_index_term[step],\sindex_term_return_accum,\s(1\s+\sindex_term_return_accum)\r\n
\s\s\s\s\s\s\s\s*\s(1\s+\smax(safe_return(equity_index,\sindex_at_last_index_term_end)\r\n
\s\s\s\s\s\s\s\s*\sdeclared_parameter[step_esg-1]\s-\sannexus_spread,\r\n
\s\s\s\s\s\s\s\slocal_floor))\s-\s1))\r\n
end\s</c>
            <c name="monthly_p2p_return">=iif(is_monthiversary[step],\ssafe_return(equity_index,\sindex_at_last_monthiversary),\s0)</c>
            <c name="monthly_p2p_return_accum">=\siif(\r\n
\s\s\s\sprev(credit_interest_now),\r\n
\s\s\s\smin(monthly_p2p_return,\sdeclared_parameter[step_esg-1]),\r\n
\s\s\s\sprev(monthly_p2p_return_accum)\s+\smin(monthly_p2p_return,\sdeclared_parameter[step_esg-1])\r\n
)</c>
            <c name="monthly_sum">if\sprev(credit_interest_now)\sthen\r\n
\s\s\s\sreturn\siif(is_monthiversary[step],\sequity_index,\s0)\r\n
end\r\n
\r\n
return\siif(\r\n
\s\s\s\sis_monthiversary[step],\r\n
\s\s\s\sprev(monthly_sum)\s+\sequity_index,\r\n
\s\s\s\sprev(monthly_sum)\r\n
)\s\s</c>
            <c name="n_month">if\sprev(credit_interest_now)\sthen\r\n
\s\s\s\sreturn\siif(is_monthiversary[step],\s1,\s0)\r\n
end\r\n
\r\n
return\siif(is_monthiversary[step],\sprev(n_month)\s+\s1,\sprev(n_month))</c>
            <c name="monthly_average">=\siif(n_month\s!=\s0,\smonthly_sum\s/\sn_month,\s0)</c>
            <c name="monthly_average_return">=\siif(\r\n
\s\s\s\sn_month\s!=\s0,\r\n
\s\s\s\ssafe_return(monthly_average,\sindex_at_last_credit),\r\n
\s\s\s\s0\r\n
)</c>
            <c name="strategy_return">/*\r\n
Fixed\saccount\sinterest\scredited,\r\n
which\sis\sthe\smultiplication\sof\saccount\sfund\svalue\sand\smonthly\srate.\s\r\n
$$\smonthly\\text{_}rate\s=\s(1\s+\sannually\\text{_}rate)^{dt}\s-\s1\s$$\r\n
*/\r\n
\r\n
switch\sinforce.investment_account\r\n
\s\s\s\scase\s0:\s//\sFixed\saccount\r\n
\s\s\s\s\s\s\s\sreturn\sdeclared_parameter[step_esg-1]\r\n
\s\s\s\scase\s1:\s//\s1y\sAnnual\sP2P\s(cap)\r\n
\s\s\s\s\s\s\s\s//\sfor\spolicy\shaving\sboth\sparticipation\srate\sand\scap\r\n
\s\s\s\s\s\s\s\sif\sfirst_credit_now\sor\sdisable_rate_setting\sor\sno_rate_setting\sthen\s\r\n
\s\s\s\s\s\s\s\s\s\s\s\sreturn\smax(min(inforce.participation_rate\s*\sp2p_return,\sdeclared_parameter[step_esg-1]),\sinforce.index_floor)\r\n
\s\s\s\s\s\s\s\selse\s\s\s\s//\sroll\sto\sa\spure\scap\swhen\safter\srate\ssetting\r\n
\s\s\s\s\s\s\s\s\s\s\s\sreturn\smax(min(p2p_return,\sdeclared_parameter[step_esg-1]),\sinforce.index_floor)\r\n
\s\s\s\s\s\s\s\sendif\r\n
\s\s\s\scase\s2:\s//\sMonthly\sP2P\r\n
\s\s\s\s\s\s\s\sif\sfirst_credit_now\sor\s!first_credit_passed\sthen\r\n
\s\s\s\s\s\s\s\s\s\s\s\sreturn\smax(monthly_p2p_return_accum,\sinforce.index_floor)\r\n
\s\s\s\s\s\s\s\selse\s\s//\sroll\sto\sa\spure\scap\safter\srate\ssetting\r\n
\s\s\s\s\s\s\s\s\s\s\s\sreturn\smax(min(p2p_return,\sdeclared_parameter[step_esg-1]),\sinforce.index_floor)\r\n
\s\s\s\s\s\s\s\sendif\s\s\r\n
\s\s\s\scase\s3:\s//\sMonthly\sAverage\s(w/spread)\r\n
\s\s\s\s\s\s\s\sif\sfirst_credit_now\sor\s!first_credit_passed\sthen\r\n
\s\s\s\s\s\s\s\s\s\s\s\sreturn\smax(monthly_average_return\s-\sdeclared_parameter[step_esg-1],\sinforce.index_floor)\r\n
\s\s\s\s\s\s\s\selse\s\s\s\s\s//\sroll\sto\sa\spure\spar\safter\srate\ssetting\r\n
\s\s\s\s\s\s\s\s\s\s\s\sreturn\smax(p2p_return\s*\sdeclared_parameter[step_esg-1],\sinforce.index_floor)\r\n
\s\s\s\s\s\s\s\sendif\r\n
\s\s\s\scase\s4:\s//\sMLSB\sP2P\s1-year\swith\sspread\r\n
\s\s\s\s\s\s\s\sreturn\smax(p2p_return\s-\sdeclared_parameter[step_esg-1],\sinforce.index_floor)\r\n
\s\s\s\scase\s5:\s//\sMLSB\sP2P\s2-year\swith\sspread\r\n
\s\s\s\s\s\s\s\sreturn\siif(compare(pro_rata_factor[step]\s&lt;=\s0.5,\s1e-06),\r\n
\s\s\s\s\s\s\s\s\s\s\s\smax(p2p_return\s-\sdeclared_parameter[step_esg-1]\s/\s2,\sinforce.index_floor),\r\n
\s\s\s\s\s\s\s\s\s\s\s\smax(p2p_return\s-\sdeclared_parameter[step_esg-1],\sinforce.index_floor))\r\n
\s\s\s\scase\s6:\s//\sAnnual\sP2P\s(Participation\srate)\r\n
\s\s\s\s\s\s\s\sreturn\smax(p2p_return\s*\sdeclared_parameter[step_esg-1],\sinforce.index_floor)\r\n
